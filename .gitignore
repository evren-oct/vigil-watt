bin/
obj/
*.user
.vs/
# 发布产物（仓库根 publish/）；规则无前导斜杠，任意层级名为 publish 的目录都忽略
publish/
# 安装包产物（scripts/build-installer.ps1 输出：Setup.exe + RELEASES + nupkg）
dist/
# Gitee 发布令牌（scripts/publish-gitee.ps1 由人工读进 GITEE_TOKEN），绝不入库
.vpk-gitee-token
*.log

# 工具 / 助手元数据目录（不入库）
.workbuddy/
.workbuddy-ai/
.zcode/
# CodeGraph 索引：codegraph.db 约 22MB，其自带 .gitignore 也写明"local to each machine, not for committing"
.codegraph/
