<Window
    x:Class="VigilWatt.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="VigilWatt">

    <!-- Root 背景由 MainWindow.ApplyBackdrop() 控制：Mica/Acrylic 下必须为 null，只有 Solid 才铺色（见 dev/runtime-pitfalls.md §13） -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏融入区：左侧品牌与侧栏同宽，右侧整条留作拖拽；标题不抢系统按钮 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" ColumnDefinitions="216,*">
            <StackPanel Grid.Column="0" Margin="22,0,0,0" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="VigilWatt" FontSize="13" FontWeight="Bold" />
                <TextBlock Text="无线设备电量监控" FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <muxc:NavigationView x:Name="Nav" Grid.Row="1"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             IsPaneToggleButtonVisible="False"
                             IsTitleBarAutoPaddingEnabled="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="216"
                             Background="Transparent"
                             SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.Resources>
                <!-- 侧栏图标统一取 Tabler Icons 3.31.0（MIT，见 Assets/tabler-icons-LICENSE.txt） -->
                <FontFamily x:Key="TablerIconFont">ms-appx:///Assets/tabler-icons.ttf#tabler-icons</FontFamily>
                <StaticResource x:Key="NavigationViewItemBackgroundSelected"
                                ResourceKey="CardBackgroundFillColorDefaultBrush" />
                <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver"
                                ResourceKey="CardBackgroundFillColorDefaultBrush" />
                <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed"
                                ResourceKey="SubtleFillColorSecondaryBrush" />
                <StaticResource x:Key="NavigationViewItemBackgroundPointerOver"
                                ResourceKey="AppHoverFillBrush" />
                <StaticResource x:Key="NavigationViewItemBackgroundPressed"
                                ResourceKey="AppSearchFillBrush" />
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
                <Thickness x:Key="NavigationViewItemButtonMargin">0,1</Thickness>
                <Thickness x:Key="NavigationViewItemContentPresenterMargin">0</Thickness>
                <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">18</x:Double>
                <x:Double x:Key="NavigationViewItemOnLeftMinHeight">34</x:Double>
                <Style TargetType="muxc:NavigationViewItem">
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Height" Value="34" />
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="Margin" Value="0,1" />
                </Style>
                <Style TargetType="muxc:NavigationViewItemHeader">
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="FontWeight" Value="Medium" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Setter Property="Margin" Value="10,20,0,6" />
                </Style>
                <Style x:Key="NavVersionHeaderStyle" TargetType="muxc:NavigationViewItemHeader">
                    <Setter Property="MinHeight" Value="20" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Setter Property="Margin" Value="10,8,0,10" />
                </Style>
            </muxc:NavigationView.Resources>

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItemHeader Content="监控" />
                <muxc:NavigationViewItem Content="设备电量" Tag="devices" IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA34;" FontFamily="{StaticResource TablerIconFont}" FontSize="18" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="历史统计" Tag="stats">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA59;" FontFamily="{StaticResource TablerIconFont}" FontSize="18" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="历史管理" Tag="history">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA88;" FontFamily="{StaticResource TablerIconFont}" FontSize="18" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="设备诊断" Tag="capture">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xED23;" FontFamily="{StaticResource TablerIconFont}" FontSize="18" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItemHeader Content="系统" />
                <muxc:NavigationViewItem Content="设置" Tag="settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA03;" FontFamily="{StaticResource TablerIconFont}" FontSize="18" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="关于" Tag="about">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEAC5;" FontFamily="{StaticResource TablerIconFont}" FontSize="18" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItemHeader x:Name="VersionHeader" Style="{StaticResource NavVersionHeaderStyle}" />
            </muxc:NavigationView.FooterMenuItems>

            <Grid>
                <muxc:Frame x:Name="ContentFrame" />
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
