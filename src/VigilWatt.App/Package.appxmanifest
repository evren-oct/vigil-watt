<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap10 desktop rescap">
  <Identity Name="VigilWatt.App" Publisher="CN=VigilWatt" Version="1.3.99.1" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>VigilWatt</DisplayName>
    <PublisherDisplayName>VigilWatt</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.19045.0" />
  </Dependencies>
  <Resources><Resource Language="en-US" /></Resources>
  <Applications>
    <Application Id="VigilWatt" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements DisplayName="VigilWatt" Description="VigilWatt battery monitor"
          BackgroundColor="#232F3E" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="VigilWatt.App.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="VigilWattStartup" Enabled="false" DisplayName="VigilWatt" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities><rescap:Capability Name="runFullTrust" /></Capabilities>
</Package>
