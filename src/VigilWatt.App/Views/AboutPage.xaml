<Page
    x:Class="VigilWatt.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="CapPillStyle" TargetType="Border" BasedOn="{StaticResource AppPillStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="40,24,40,88" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="0" MaxWidth="900">

            <TextBlock Text="VigilWatt" Style="{StaticResource AppPageTitleStyle}" />
            <TextBlock Text="Windows 看不到 2.4G 外设电量，所以做了这个托盘。"
                       Margin="0,7,0,0" FontSize="15" TextWrapping="Wrap" MaxWidth="620"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="VersionText" Margin="0,4,0,0" FontSize="13"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,20,0,0">
                <Border Style="{StaticResource CapPillStyle}"
                        Background="{ThemeResource AppNeutralPillFillBrush}">
                    <TextBlock Text="蓝牙耳机" FontSize="13" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <Border Style="{StaticResource CapPillStyle}"
                        Background="{ThemeResource AppNeutralPillFillBrush}">
                    <TextBlock Text="2.4G 键鼠手柄" FontSize="13" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <Border Style="{StaticResource CapPillStyle}"
                        Background="{ThemeResource AppNeutralPillFillBrush}">
                    <TextBlock Text="可选的本机电量" FontSize="13" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>

            <!-- 软件更新 -->
            <TextBlock Text="更新" Style="{StaticResource AppSectionTitleStyle}" Margin="0,24,0,6" />
            <Border Style="{StaticResource AppCardStyle}">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="20,18" MinHeight="64">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateStatusText" FontSize="15" />
                            <TextBlock Text="启动时自动检查 GitHub Release，连不上再回退 Gitee；发现新版本后会先征求确认"
                                       FontSize="13" TextWrapping="Wrap" MaxWidth="560"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <ProgressBar x:Name="UpdateProgressBar" Height="4" Margin="0,8,0,0"
                                         Minimum="0" Maximum="100" Visibility="Collapsed" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1" x:Name="CheckUpdateButton" Content="检查"
                                         Padding="0" FontSize="15" VerticalAlignment="Center"
                                         Click="CheckUpdate_Click" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="20,18" MinHeight="64">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="更新日志" FontSize="15" />
                            <TextBlock Text="每个版本改了什么，随安装包分发，离线可看"
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1" Content="在 GitHub 查看"
                                         Padding="0" FontSize="15" VerticalAlignment="Center"
                                         Click="OpenReleases_Click" />
                    </Grid>

                    <!-- 更新日志自成一块滚动区：版本再多也只在这个框里滚，不把整页撑长 -->
                    <Border Margin="20,0,20,18" CornerRadius="10"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <ScrollViewer x:Name="NotesScroll" MinHeight="140" MaxHeight="320"
                                      Padding="16,14,12,14"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalContentAlignment="Stretch">
                            <StackPanel x:Name="NotesHost" Spacing="6" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 功能简介 -->
            <TextBlock Text="功能" Style="{StaticResource AppSectionTitleStyle}" Margin="0,24,0,6" />
            <Border Style="{StaticResource AppCardStyle}">
                <StackPanel>
                    <StackPanel Padding="20,18" Spacing="2">
                        <TextBlock Text="剩余时间估算" FontSize="15" />
                        <TextBlock Text="根据设备近期电量变化估算可用时间；采样不足或近期电量没有下降时，会提示当前原因。"
                                   FontSize="13" TextWrapping="Wrap" MaxWidth="620"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel Padding="20,0,20,18" Spacing="2">
                        <TextBlock Text="右键重命名" FontSize="15" />
                        <TextBlock Text="在设备列表中右键设备，可设置更容易识别的自定义名称和图标。"
                                   FontSize="13" TextWrapping="Wrap" MaxWidth="620"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 项目 / 联系 -->
            <TextBlock Text="项目" Style="{StaticResource AppSectionTitleStyle}" Margin="0,24,0,6" />
            <Border Style="{StaticResource AppCardStyle}">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Padding="20,18" MinHeight="64">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Gitee" FontSize="15" />
                            <TextBlock Text="YGWG-LX / vigil-watt" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1" Content="打开" Padding="0" FontSize="15"
                                         VerticalAlignment="Center" Click="OpenRepo_Click" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Padding="20,18" MinHeight="64">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="GitHub" FontSize="15" />
                            <TextBlock Text="evren-oct / vigil-watt" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1" Content="打开" Padding="0" FontSize="15"
                                         VerticalAlignment="Center" Click="OpenGitHub_Click" />
                    </Grid>
                    <StackPanel Padding="20,0,20,18" Spacing="2">
                        <TextBlock Text="联系" FontSize="15" />
                        <HyperlinkButton Content="xliu-oct@qq.com" Padding="0" FontSize="13"
                                         NavigateUri="mailto:xliu-oct@qq.com" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="MIT License · 本项目只读取设备状态，不修改任何设备配置"
                       Margin="0,40,0,0" FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
