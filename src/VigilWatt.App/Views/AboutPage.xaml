<Page
    x:Class="VigilWatt.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="CapPillStyle" TargetType="Border" BasedOn="{StaticResource AppPillStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="40,24,40,88" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="0" MaxWidth="900">

            <TextBlock Text="VigilWatt" Style="{StaticResource AppPageTitleStyle}" />
            <TextBlock Text="{Binding S_5e6bbc543f, Mode=OneWay}"
                       Margin="0,7,0,0" FontSize="15" TextWrapping="Wrap" MaxWidth="620"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="VersionText" Margin="0,4,0,0" FontSize="13"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,20,0,0">
                <Border Style="{StaticResource CapPillStyle}"
                        Background="{ThemeResource AppNeutralPillFillBrush}">
                    <TextBlock Text="{Binding S_c165ba296a, Mode=OneWay}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <Border Style="{StaticResource CapPillStyle}"
                        Background="{ThemeResource AppNeutralPillFillBrush}">
                    <TextBlock Text="{Binding S_58887d70b1, Mode=OneWay}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <Border Style="{StaticResource CapPillStyle}"
                        Background="{ThemeResource AppNeutralPillFillBrush}">
                    <TextBlock Text="{Binding S_f9434a557c, Mode=OneWay}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>

            <!-- 软件更新 -->
            <TextBlock Text="{Binding S_d9db02d07a, Mode=OneWay}" Style="{StaticResource AppSectionTitleStyle}" Margin="0,24,0,6" />
            <Border Style="{StaticResource AppCardStyle}">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="20,18" MinHeight="64">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateStatusText" FontSize="15" />
                            <TextBlock Text="{Binding S_63c3524b0a, Mode=OneWay}"
                                       FontSize="13" TextWrapping="Wrap" MaxWidth="560"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <ProgressBar x:Name="UpdateProgressBar" Height="4" Margin="0,8,0,0"
                                         Minimum="0" Maximum="100" Visibility="Collapsed" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1" x:Name="CheckUpdateButton" Content="{Binding S_40ffb34860, Mode=OneWay}"
                                         Padding="0" FontSize="15" VerticalAlignment="Center"
                                         Click="CheckUpdate_Click" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="20,18" MinHeight="64">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding S_185368440e, Mode=OneWay}" FontSize="15" />
                            <TextBlock Text="{Binding S_fdbff9987c, Mode=OneWay}"
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1" Content="{Binding S_f5ac314da6, Mode=OneWay}"
                                         Padding="0" FontSize="15" VerticalAlignment="Center"
                                         Click="OpenReleases_Click" />
                    </Grid>

                    <!-- 更新日志自成一块滚动区：版本再多也只在这个框里滚，不把整页撑长 -->
                    <Border Margin="20,0,20,18" CornerRadius="10"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <ScrollViewer x:Name="NotesScroll" MinHeight="140" MaxHeight="320"
                                      Padding="16,14,12,14"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalContentAlignment="Stretch">
                            <StackPanel x:Name="NotesHost" Spacing="6" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 功能简介 -->
            <TextBlock Text="{Binding S_4e1ff3eb77, Mode=OneWay}" Style="{StaticResource AppSectionTitleStyle}" Margin="0,24,0,6" />
            <Border Style="{StaticResource AppCardStyle}">
                <StackPanel>
                    <StackPanel Padding="20,18" Spacing="2">
                        <TextBlock Text="{Binding S_f72a2d2e3f, Mode=OneWay}" FontSize="15" />
                        <TextBlock Text="{Binding S_71683c08ba, Mode=OneWay}"
                                   FontSize="13" TextWrapping="Wrap" MaxWidth="620"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel Padding="20,0,20,18" Spacing="2">
                        <TextBlock Text="{Binding S_caabe86af6, Mode=OneWay}" FontSize="15" />
                        <TextBlock Text="{Binding S_942a986c1f, Mode=OneWay}"
                                   FontSize="13" TextWrapping="Wrap" MaxWidth="620"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 项目 / 联系 -->
            <TextBlock Text="{Binding S_22336e6b89, Mode=OneWay}" Style="{StaticResource AppSectionTitleStyle}" Margin="0,24,0,6" />
            <Border Style="{StaticResource AppCardStyle}">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Padding="20,18" MinHeight="64">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Gitee" FontSize="15" />
                            <TextBlock Text="YGWG-LX / vigil-watt" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1" Content="{Binding S_65fc81e161, Mode=OneWay}" Padding="0" FontSize="15"
                                         VerticalAlignment="Center" Click="OpenRepo_Click" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Padding="20,18" MinHeight="64">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="GitHub" FontSize="15" />
                            <TextBlock Text="evren-oct / vigil-watt" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <HyperlinkButton Grid.Column="1" Content="{Binding S_65fc81e161, Mode=OneWay}" Padding="0" FontSize="15"
                                         VerticalAlignment="Center" Click="OpenGitHub_Click" />
                    </Grid>
                    <StackPanel Padding="20,0,20,18" Spacing="2">
                        <TextBlock Text="{Binding S_4dd6926e26, Mode=OneWay}" FontSize="15" />
                        <HyperlinkButton Content="xliu-oct@qq.com" Padding="0" FontSize="13"
                                         NavigateUri="mailto:xliu-oct@qq.com" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding S_84862e6d50, Mode=OneWay}"
                       Margin="0,40,0,0" FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
