<Page
    x:Class="VigilWatt.App.Views.CapturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:VigilWatt.App.ViewModels">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*" Padding="40,24,40,24" RowSpacing="20"
          MaxWidth="900" SizeChanged="RootGrid_SizeChanged">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="7" VerticalAlignment="Center">
                <TextBlock Text="{Binding S_7e2e1f2b8f, Mode=OneWay}" Style="{StaticResource AppPageTitleStyle}" />
                <TextBlock x:Name="SubtitleText" Text="{Binding S_60a4d475c3, Mode=OneWay}"
                           Style="{StaticResource AppPageSubtitleStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding S_27ea588f42, Mode=OneWay}"
                           FontSize="13" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <Border x:Name="WindowHint" Visibility="Collapsed" HorizontalAlignment="Left"
                        CornerRadius="12" Padding="10,5" Margin="0,4,0,0">
                    <TextBlock x:Name="WindowHintText" TextWrapping="Wrap" FontSize="13" FontWeight="Medium"
                               Text="{Binding S_95d990f8e9, Mode=OneWay}" />
                </Border>
            </StackPanel>
            <HyperlinkButton x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click"
                             Padding="0" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;"
                              Foreground="{ThemeResource AppAccentBrush}" />
                    <TextBlock Text="{Binding S_251a0e8cde, Mode=OneWay}" FontSize="15"
                               Foreground="{ThemeResource AppAccentBrush}" />
                </StackPanel>
            </HyperlinkButton>
        </Grid>

        <InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="2">

            <!-- ========== 空闲态：左边选设备（列表占满高度、自己滚），右边 02/03 单独滚 ========== -->
            <Grid x:Name="IdlePanel" ColumnSpacing="20" SizeChanged="IdlePanel_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.42*" MinWidth="250" />
                    <ColumnDefinition Width="0.58*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="DevicePickCard" Grid.Column="0" Style="{StaticResource AppCardPaddedStyle}">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <TextBlock Text="01" FontSize="11" FontWeight="Medium"
                                       Foreground="{ThemeResource AppAccentBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding S_a581a1f7fb, Mode=OneWay}" FontSize="17" FontWeight="Medium" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="6">
                            <RadioButton x:Name="TaskUnknown" GroupName="CaptureTask" IsChecked="True"
                                         Checked="Task_Checked">
                                <TextBlock Text="{Binding S_eb94933afe, Mode=OneWay}" TextWrapping="Wrap" />
                            </RadioButton>
                            <RadioButton x:Name="TaskSupported" GroupName="CaptureTask"
                                         Checked="Task_Checked">
                                <TextBlock Text="{Binding S_afe1cc98fc, Mode=OneWay}" TextWrapping="Wrap" />
                            </RadioButton>
                        </StackPanel>
                        <TextBlock Grid.Row="2" x:Name="TaskHint" Style="{StaticResource AppCardFootnoteStyle}" TextWrapping="Wrap"
                                   Text="{Binding S_eebe07616e, Mode=OneWay}" />

                        <ListView Grid.Row="3" x:Name="DeviceList" SelectionMode="Single"
                                  SelectionChanged="DeviceList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="v:CaptureDeviceRow">
                                        <StackPanel Spacing="1" Padding="0,4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="Medium" />
                                                <TextBlock Text="{x:Bind Status}" Style="{StaticResource AppCardFootnoteStyle}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource AppCardFootnoteStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Grid.Row="4" x:Name="DeviceHint" Style="{StaticResource AppCardFootnoteStyle}" TextWrapping="Wrap"
                                   Text="{Binding S_9409dc11ab, Mode=OneWay}" />
                    </Grid>
                </Border>

                <ScrollViewer x:Name="DetailScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="20">
                    <Border Style="{StaticResource AppCardPaddedStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <TextBlock Text="02" FontSize="11" FontWeight="Medium"
                                           Foreground="{ThemeResource AppAccentBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding S_5d1474054c, Mode=OneWay}" FontSize="17" FontWeight="Medium" />
                            </StackPanel>
                            <!-- 左接口右预检：预检在选中接口时自动跑，这里的宽度比例与运行态两列一致 -->
                            <Grid x:Name="InterfaceProbeGrid" ColumnDefinitions="1*,1.2*" ColumnSpacing="16"
                                  RowSpacing="12" SizeChanged="InterfaceProbeGrid_SizeChanged">
                                <StackPanel x:Name="InterfaceColumn" Grid.Column="0" Spacing="8">
                                    <ListView x:Name="InterfaceList" SelectionMode="Single" IsEnabled="False"
                                              MaxHeight="260"
                                              SelectionChanged="InterfaceList_SelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="v:CaptureInterfaceRow">
                                                <StackPanel Spacing="1" Padding="0,4">
                                                    <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="Medium" />
                                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource AppCardFootnoteStyle}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock x:Name="InterfaceHint" Style="{StaticResource AppCardFootnoteStyle}" TextWrapping="Wrap"
                                               Text="{Binding S_96f3840d57, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel x:Name="ProbeColumn" Grid.Column="1" Spacing="8">
                                    <TextBlock x:Name="CapabilitySummary" Style="{StaticResource AppCardFootnoteStyle}"
                                               TextWrapping="Wrap" Text="{Binding S_a10c8a89fa, Mode=OneWay}" />
                                    <CheckBox x:Name="ShowAllCapsCheck" Content="{Binding S_7319539620, Mode=OneWay}" IsEnabled="False"
                                              Checked="ShowAllCaps_Changed" Unchecked="ShowAllCaps_Changed" />
                                    <ListView x:Name="CapabilityList" SelectionMode="None" MaxHeight="240">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="v:CaptureCapabilityRow">
                                                <StackPanel Spacing="1" Padding="0,4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="Medium" />
                                                        <TextBlock Text="{x:Bind Status}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource AppCardFootnoteStyle}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <CheckBox x:Name="FeatureCheck" Content="{Binding S_4a544fa16d, Mode=OneWay}" IsEnabled="False"
                                                  Checked="FeatureCheck_Changed" Unchecked="FeatureCheck_Changed" />
                                        <ComboBox x:Name="FeatureIdBox" MinWidth="120" IsEnabled="False"
                                                  Header="report ID" PlaceholderText="{Binding S_4b3fa0d869, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource AppCardFootnoteStyle}" TextWrapping="Wrap"
                                               Text="{Binding S_0278bfedbd, Mode=OneWay}" />

                                    <CheckBox x:Name="AllowSendCheck" Content="{Binding S_66675d281d, Mode=OneWay}"
                                              IsEnabled="False" />
                                    <TextBlock x:Name="AllowSendHint" Style="{StaticResource AppCardFootnoteStyle}"
                                               TextWrapping="Wrap"
                                               Text="{Binding S_6291cde9c3, Mode=OneWay}" />

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="ProbeButton" Content="{Binding S_bef64ed92d, Mode=OneWay}" Click="Probe_Click" IsEnabled="False" />
                                        <Button x:Name="StartButton" Content="{Binding S_dc6daec103, Mode=OneWay}" Click="Start_Click" IsEnabled="False"
                                                Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ResultCard" Style="{StaticResource AppCardPaddedStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <TextBlock Text="03" FontSize="11" FontWeight="Medium"
                                           Foreground="{ThemeResource AppAccentBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding S_3313676209, Mode=OneWay}" FontSize="17" FontWeight="Medium" />
                            </StackPanel>
                            <TextBlock x:Name="ResultText" Style="{StaticResource AppCardFootnoteStyle}" TextWrapping="Wrap"
                                       Text="{Binding S_836eeeda6d, Mode=OneWay}" />
                            <!-- 整场没变的分组要在结果卡上直说：用户会看这里，报告里的结论他不一定翻 -->
                            <TextBlock x:Name="ResultWarn" Style="{StaticResource AppCardFootnoteStyle}" TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="OpenReportButton" Content="{Binding S_d656ddcd80, Mode=OneWay}" Click="OpenReport_Click" IsEnabled="False" />
                                <Button x:Name="OpenFolderButton" Content="{Binding S_ba54ce3c46, Mode=OneWay}" Click="OpenFolder_Click" IsEnabled="False" />
                                <Button x:Name="SaveAsButton" Content="{Binding S_1ab3f814d3, Mode=OneWay}" Click="SaveAs_Click" IsEnabled="False" />
                                <Button x:Name="CopySummaryButton" Content="{Binding S_f955f7dc1e, Mode=OneWay}" Click="CopySummary_Click" IsEnabled="False" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource AppCardFootnoteStyle}" TextWrapping="Wrap"
                                       Text="{Binding S_37b1433a90, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppCardPaddedStyle}">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{Binding S_00a76de976, Mode=OneWay}" FontSize="17" FontWeight="Medium" />
                            <ListView x:Name="HistoryList" SelectionMode="Single"
                                      IsItemClickEnabled="True" ItemClick="HistoryList_ItemClick"
                                      MaxHeight="260">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="v:CaptureHistoryRow">
                                        <StackPanel Spacing="1" Padding="0,4">
                                            <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="Medium" />
                                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource AppCardFootnoteStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="HistoryHint" Style="{StaticResource AppCardFootnoteStyle}"
                                       Text="{Binding S_8e8b9d4f30, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========== 运行态：设备横幅 + 步骤条 + 左引导/控制 + 右实时记录 ========== -->
            <Grid x:Name="RunningPanel" Visibility="Collapsed" RowDefinitions="Auto,Auto,*" RowSpacing="12"
                  SizeChanged="RunningPanel_SizeChanged">

                <!-- 选择卡收起后，这里是唯一还能确认「采的是哪台、哪个接口」的地方 -->
                <Border x:Name="DeviceBanner" Grid.Row="0" Style="{StaticResource AppCardStyle}" Padding="16,10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <TextBlock x:Name="DeviceBannerName" Grid.Column="0" FontSize="15" FontWeight="Medium"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DeviceBannerMeta" Grid.Column="1" FontSize="13" VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>

                <Grid x:Name="StepBar" Grid.Row="1" ColumnSpacing="6" />

                <Grid x:Name="RunningContent" Grid.Row="2" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="GuideColumn" Grid.Column="0" Spacing="24">
                        <Border Style="{StaticResource AppCardPaddedStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="GuideTitle" FontWeight="Medium" FontSize="17" TextWrapping="Wrap"
                                           Text="{Binding S_544ce57eda, Mode=OneWay}" />
                                <TextBlock x:Name="GuideHint" TextWrapping="Wrap" Text="—" />
                                <TextBlock x:Name="GuideDeviceWarning" TextWrapping="Wrap" Visibility="Collapsed"
                                           Style="{StaticResource AppCardFootnoteStyle}"
                                           Text="{Binding S_5f05735f2d, Mode=OneWay}" />
                                <TextBlock x:Name="GuideProgress" Style="{StaticResource AppCardFootnoteStyle}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="GuideNextButton" Click="GuideNext_Click" IsEnabled="False"
                                            Style="{StaticResource AccentButtonStyle}"
                                            ToolTipService.ToolTip="Ctrl+Enter">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Modifiers="Control" Key="Enter" />
                                        </Button.KeyboardAccelerators>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding S_dfbce27e9c, Mode=OneWay}" />
                                            <TextBlock Text="Ctrl+Enter" Opacity="0.7" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="GuideRedoButton" Click="GuideRedo_Click" IsEnabled="False"
                                            ToolTipService.ToolTip="Ctrl+R">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Modifiers="Control" Key="R" />
                                        </Button.KeyboardAccelerators>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding S_1238f0d363, Mode=OneWay}" />
                                            <TextBlock Text="Ctrl+R" Opacity="0.6" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="GuideBackButton" Click="GuideBack_Click" IsEnabled="False"
                                            ToolTipService.ToolTip="Ctrl+←">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Modifiers="Control" Key="Left" />
                                        </Button.KeyboardAccelerators>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding S_75ef1241c0, Mode=OneWay}" />
                                            <TextBlock Text="Ctrl+←" Opacity="0.6" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_e89a011f0b, Mode=OneWay}" VerticalAlignment="Center"
                                               Style="{StaticResource AppCardFootnoteStyle}" />
                                    <TextBox x:Name="BatteryBox" Width="72" PlaceholderText="78"
                                             InputScope="Number" IsEnabled="False" />
                                    <TextBlock Text="%" VerticalAlignment="Center"
                                               Style="{StaticResource AppCardFootnoteStyle}" />
                                    <Button x:Name="BatteryButton" Content="{Binding S_f1ef333a8e, Mode=OneWay}" Click="Battery_Click"
                                            IsEnabled="False" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource AppCardFootnoteStyle}" TextWrapping="Wrap"
                                           Text="{Binding S_5845075331, Mode=OneWay}" />
                                <TextBlock x:Name="BatteryStatus" Style="{StaticResource AppCardFootnoteStyle}"
                                           TextWrapping="Wrap" Text="{Binding S_5de955fd0f, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource AppCardPaddedStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding S_b6505bbff0, Mode=OneWay}" FontSize="17" FontWeight="Medium" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="PauseButton" Click="Pause_Click" IsEnabled="False"
                                            ToolTipService.ToolTip="Ctrl+P">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Modifiers="Control" Key="P" />
                                        </Button.KeyboardAccelerators>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock x:Name="PauseLabel" Text="{Binding S_130448bce6, Mode=OneWay}" />
                                            <TextBlock Text="Ctrl+P" Opacity="0.6" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="StopButton" Click="Stop_Click" IsEnabled="False"
                                            ToolTipService.ToolTip="Ctrl+S">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Modifiers="Control" Key="S" />
                                        </Button.KeyboardAccelerators>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding S_2d844f190f, Mode=OneWay}" />
                                            <TextBlock Text="Ctrl+S" Opacity="0.6" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AbandonButton" Click="Abandon_Click" IsEnabled="False"
                                            ToolTipService.ToolTip="{Binding S_8f90a8774d, Mode=OneWay}">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                                        </Button.KeyboardAccelerators>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding S_432b8537b8, Mode=OneWay}" />
                                            <TextBlock Text="Ctrl+Shift+S" Opacity="0.6" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="CounterText" Style="{StaticResource AppCardFootnoteStyle}"
                                           Text="{Binding S_24c27eba37, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBox x:Name="MarkBox" PlaceholderText="{Binding S_71712c0dc0, Mode=OneWay}"
                                         IsEnabled="False" />
                                <Button x:Name="MarkButton" Content="{Binding S_e78c47fe0b, Mode=OneWay}" Click="Mark_Click" IsEnabled="False"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="SendCard" Visibility="Collapsed" Style="{StaticResource AppCardPaddedStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding S_9efd2ac56a, Mode=OneWay}" FontSize="17" FontWeight="Medium" />
                                <TextBlock x:Name="SendHint" Style="{StaticResource AppCardFootnoteStyle}"
                                           TextWrapping="Wrap" />
                                <TextBox x:Name="SendBox" PlaceholderText="{Binding S_4a32cfaba6, Mode=OneWay}" />
                                <Button x:Name="SendButton" Content="{Binding S_edf903b509, Mode=OneWay}" Click="Send_Click"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border x:Name="RecordCard" Grid.Column="1" Style="{StaticResource AppCardPaddedStyle}">
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="{Binding S_d7794afb1d, Mode=OneWay}" FontSize="17" FontWeight="Medium" />
                            <!-- 在等什么：按已采秒数升级，免得用户进来一两秒没看到报文就退掉 -->
                            <TextBlock x:Name="WaitHint" Grid.Row="1" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <ListView x:Name="RecordList" Grid.Row="2" SelectionMode="None">
                                <!-- 新报文进来时跟着滚，用户不用手动拖到最底 -->
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="v:CaptureRecordRow">
                                        <Grid>
                                            <!-- 分割行：进入某一步 / 打自定义标记时插一条，标出后面这批报文属于哪一段 -->
                                            <TextBlock Text="{x:Bind Header}" Visibility="{x:Bind HeaderVisibility}"
                                                       FontWeight="Medium" FontSize="11" TextWrapping="Wrap"
                                                       Margin="0,8,0,2"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10" Padding="0,2"
                                                  Visibility="{x:Bind RecordVisibility}">
                                                <!-- 协议通道色条：同一「类型 + report ID」始终同色，扫一眼就能分开 -->
                                                <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                        Background="{x:Bind Accent}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Time}" Style="{StaticResource AppCardFootnoteStyle}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Kind}" Style="{StaticResource AppCardFootnoteStyle}"
                                                           Foreground="{x:Bind Accent}" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind Hex}" FontFamily="Consolas"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind Note}" Style="{StaticResource AppCardFootnoteStyle}" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
