<Page
    x:Class="VigilWatt.App.Views.DeviceDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VigilWatt.App.Controls">

    <Grid RowDefinitions="Auto,*" Padding="40,24,40,88" MaxWidth="900">

        <!-- 页头：返回是面包屑式链接，右侧只留刷新；标题就是 Hero 里的设备名 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <HyperlinkButton x:Name="BackButton" Click="Back_Click" Padding="0"
                             VerticalAlignment="Center" ToolTipService.ToolTip="{Binding S_55ffda672c, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"
                              Foreground="{ThemeResource AppAccentBrush}" />
                    <TextBlock Text="{Binding S_25552a2501, Mode=OneWay}" FontSize="15"
                               Foreground="{ThemeResource AppAccentBrush}" />
                </StackPanel>
                <HyperlinkButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" />
                </HyperlinkButton.KeyboardAccelerators>
            </HyperlinkButton>

            <HyperlinkButton x:Name="RefreshButton" Grid.Column="2" Click="Refresh_Click"
                             Padding="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="RefreshRing" Width="14" Height="14"
                                  IsActive="False" Visibility="Collapsed" />
                    <FontIcon x:Name="RefreshIcon" FontSize="14" Glyph="&#xE72C;"
                              Foreground="{ThemeResource AppAccentBrush}" />
                    <TextBlock x:Name="RefreshText" Text="{Binding S_38108eaa1d, Mode=OneWay}" FontSize="15"
                               Foreground="{ThemeResource AppAccentBrush}" />
                </StackPanel>
            </HyperlinkButton>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Hidden"
                      HorizontalContentAlignment="Stretch"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24" Padding="0,0,0,8">

                <!-- Hero：设备身份 + 电量，不着卡片底色 -->
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="Plate" Grid.Column="0" Width="132" Height="104" CornerRadius="12"
                            Padding="6" VerticalAlignment="Center"
                            PointerEntered="Plate_PointerEntered" PointerExited="Plate_PointerExited">
                        <Grid>
                            <ContentControl x:Name="HeroIconHost" Padding="0"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                            <Image x:Name="HeroImage" Stretch="Uniform" Visibility="Collapsed" />
                            <Button x:Name="AdjustImageButton" Width="24" Height="24" Padding="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,6,6" CornerRadius="12"
                                    Background="#B3000000" Foreground="White" BorderThickness="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Visibility="Collapsed" Click="AdjustImage_Click"
                                    ToolTipService.ToolTip="{Binding S_46d44a2671, Mode=OneWay}">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E6000000" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF000000" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                </Button.Resources>
                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock x:Name="NameText" Style="{StaticResource AppPageTitleStyle}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock x:Name="MetaText" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Height="20">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse x:Name="OnlineDot" Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="OnlineText" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border x:Name="ConnPill" Style="{StaticResource AppPillStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock x:Name="ConnText" Style="{StaticResource AppPillTextStyle}" />
                                    <TextBlock x:Name="ConnSuffix" Text="{Binding S_1feb7c9ccc, Mode=OneWay}" FontSize="11"
                                               VerticalAlignment="Center" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="RecPill" Style="{StaticResource AppPillStyle}"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <controls:ReceiverIconPresenter x:Name="RecIcon" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RecText" Style="{StaticResource AppPillTextStyle}" />
                                </StackPanel>
                            </Border>
                            <FontIcon x:Name="ChargeMark" Glyph="&#xE945;" FontSize="14"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="StateText" FontSize="13" MaxLines="1" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="12" VerticalAlignment="Center">
                        <Grid Width="96" Height="96">
                            <controls:BatteryRing x:Name="Ring" Diameter="96" />
                            <TextBlock x:Name="PctText" Style="{StaticResource AppBatteryFigureStyle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Run x:Name="PctNumber" />
                                <Run x:Name="PctUnit" FontSize="13" />
                            </TextBlock>
                        </Grid>
                        <TextBlock x:Name="RemainingText" FontSize="13" MaxWidth="180"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <!-- 性能：1~3 个指标并排，单元格由代码按实际项数生成 -->
                <StackPanel x:Name="MetricsSection" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding S_cb1df60765, Mode=OneWay}" Style="{StaticResource AppSectionTitleStyle}" />
                        <!-- 说明常驻在标题右侧，但要有个图标提示"可以悬停" -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="{Binding S_b5ab541c8b, Mode=OneWay}">
                            <FontIcon Glyph="&#xE946;" FontSize="11" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding S_b7307f839e, Mode=OneWay}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="MetricsHost" ColumnSpacing="32" MaxWidth="640"
                          Margin="0,6,0,0" />
                </StackPanel>

                <!-- 连接：链路与体系是两个维度，各占一格 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding S_7328deebb5, Mode=OneWay}" Style="{StaticResource AppSectionTitleStyle}" />
                    <Border Style="{StaticResource AppCardPaddedStyle}">
                        <Grid ColumnSpacing="40" RowSpacing="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                <TextBlock Text="{Binding S_999365fe74, Mode=OneWay}" Style="{StaticResource AppFactLabelStyle}" />
                                <Border x:Name="ConnFactPill" Style="{StaticResource AppPillStyle}"
                                        HorizontalAlignment="Left">
                                    <TextBlock x:Name="ConnFactText" Style="{StaticResource AppPillTextStyle}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                <TextBlock Text="{Binding S_774b680950, Mode=OneWay}" Style="{StaticResource AppFactLabelStyle}" />
                                <TextBlock x:Name="ReceiverFamilyText" Style="{StaticResource AppFactValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                <TextBlock Text="{Binding S_b639d60c41, Mode=OneWay}" Style="{StaticResource AppFactLabelStyle}" />
                                <TextBlock x:Name="LinkStateText" Style="{StaticResource AppFactValueStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                <TextBlock Text="{Binding S_ac64bf332d, Mode=OneWay}" Style="{StaticResource AppFactLabelStyle}" />
                                <TextBlock x:Name="LinkBasisText" Style="{StaticResource AppFactValueStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 身份与硬件：本体与接收器并排，脚注专门解释两者不是一回事 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding S_0494361d55, Mode=OneWay}" Style="{StaticResource AppSectionTitleStyle}" />
                    <Border Style="{StaticResource AppCardPaddedStyle}">
                        <StackPanel>
                            <Grid ColumnSpacing="40" RowSpacing="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{Binding S_0132ce7298, Mode=OneWay}" Style="{StaticResource AppFactLabelStyle}" />
                                    <TextBlock x:Name="ModelText" Style="{StaticResource AppFactValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{Binding S_47a991d18c, Mode=OneWay}" Style="{StaticResource AppFactLabelStyle}" />
                                    <TextBlock x:Name="KindText" Style="{StaticResource AppFactValueStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{Binding S_b0c431675b, Mode=OneWay}" Style="{StaticResource AppFactLabelStyle}" />
                                    <TextBlock x:Name="ProtocolText" Style="{StaticResource AppFactValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{Binding S_9a04e46a8d, Mode=OneWay}" Style="{StaticResource AppFactLabelStyle}" />
                                    <TextBlock x:Name="DeviceIdText" Style="{StaticResource AppFactValueStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{Binding S_cccde45031, Mode=OneWay}" Style="{StaticResource AppFactLabelStyle}" />
                                    <TextBlock x:Name="BodyIdentityText" Style="{StaticResource AppFactValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{Binding S_c1fd5ffb03, Mode=OneWay}" Style="{StaticResource AppFactLabelStyle}" />
                                    <TextBlock x:Name="ReceiverIdentityText" Style="{StaticResource AppFactValueStyle}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="IdentityNote" Style="{StaticResource AppCardFootnoteStyle}"
                                       Margin="0,18,0,0" TextWrapping="Wrap" TextTrimming="None"
                                       MaxWidth="660" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 设备刚消失时的兜底：不留空白页 -->
                <TextBlock x:Name="GoneText" Text="{Binding S_0473975c6a, Mode=OneWay}" FontSize="13"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
