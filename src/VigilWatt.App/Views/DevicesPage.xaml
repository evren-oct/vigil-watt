<Page
    x:Class="VigilWatt.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:VigilWatt.App.ViewModels"
    xmlns:controls="using:VigilWatt.App.Controls">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,16">

        <!-- 标题 + 副标题 + 右上操作（与统计 / 历史管理页同款） -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="设备电量" Style="{StaticResource AppPageTitleStyle}" />
                <TextBlock x:Name="SummaryText" Text="—" Style="{StaticResource AppPageSubtitleStyle}" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="RefreshRing" Width="14" Height="14"
                                  IsActive="False" Visibility="Collapsed" />
                    <FontIcon x:Name="RefreshIcon" FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock x:Name="RefreshText" Text="刷新" />
                </StackPanel>
            </Button>
        </Grid>

        <ListView x:Name="DeviceList" Grid.Row="1" Margin="0,12,0,0" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="v:DeviceRowModel">
                    <Border Style="{StaticResource AppCardStyle}"
                            Padding="16,12"
                            Margin="0,0,0,8"
                            RightTapped="DeviceRow_RightTapped">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <controls:DeviceIconPresenter Grid.Column="0" VerticalAlignment="Center"
                                                          Kind="{x:Bind IconKind, Mode=OneWay}"
                                                          IconColor="{x:Bind IconColor, Mode=OneWay}" />
                            <StackPanel Grid.Column="1" Spacing="6">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                            Background="{x:Bind SourceBackgroundBrush, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind SourceText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{x:Bind SourceBrush, Mode=OneWay}" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="⚡" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{x:Bind ProgressBrush, Mode=OneWay}"
                                               Visibility="{x:Bind IsCharging, Mode=OneWay}" />
                                </Grid>
                                <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Height="6"
                                             CornerRadius="3" Foreground="{x:Bind ProgressBrush, Mode=OneWay}" />
                                <!-- DPI / 档位 / 回报率：标签按类别上色、数值跟主题前景色，未获取的项整段灰显 -->
                                <TextBlock FontSize="12" Visibility="{x:Bind HasPointer, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{x:Bind DpiLabel, Mode=OneWay}" Foreground="{x:Bind DpiLabelBrush, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" " />
                                    <Run Text="{x:Bind DpiValue, Mode=OneWay}" Foreground="{x:Bind DpiValueBrush, Mode=OneWay}" />
                                    <Run Text="{x:Bind LevelSeparator, Mode=OneWay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Run Text="{x:Bind LevelLabel, Mode=OneWay}" Foreground="{x:Bind LevelLabelBrush, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" " />
                                    <Run Text="{x:Bind LevelValue, Mode=OneWay}" Foreground="{x:Bind LevelValueBrush, Mode=OneWay}" />
                                    <Run Text="{x:Bind RateSeparator, Mode=OneWay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Run Text="{x:Bind RateLabel, Mode=OneWay}" Foreground="{x:Bind RateLabelBrush, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" " />
                                    <Run Text="{x:Bind RateValue, Mode=OneWay}" Foreground="{x:Bind RateValueBrush, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{x:Bind SubText, Mode=OneWay}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind PercentText, Mode=OneWay}" FontSize="26"
                                       FontWeight="Bold" VerticalAlignment="Center"
                                       MinWidth="78" TextAlignment="Right"
                                       Foreground="{x:Bind PercentBrush, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="6" Visibility="Collapsed">
            <FontIcon Glyph="&#xE702;" FontSize="40" HorizontalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="未发现设备" FontSize="15" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="EmptyHint" Text="连接蓝牙设备或插入 2.4G 接收器，然后点击刷新" FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <!-- 不在列表里的设备只能从这里恢复：忽略与永久移除是两套名单，各给一个入口；都为 0 时整行隐藏 -->
        <StackPanel x:Name="HiddenBars" Grid.Row="2" Orientation="Horizontal" Spacing="16"
                    Margin="0,4,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
            <HyperlinkButton x:Name="IgnoredBar" Padding="0" Click="ManageIgnored_Click" Visibility="Collapsed">
                <TextBlock x:Name="IgnoredText" FontSize="12" />
            </HyperlinkButton>
            <HyperlinkButton x:Name="BlockedBar" Padding="0" Click="ManageBlocked_Click" Visibility="Collapsed">
                <TextBlock x:Name="BlockedText" FontSize="12" />
            </HyperlinkButton>
        </StackPanel>
    </Grid>
</Page>
