<Page
    x:Class="VigilWatt.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:VigilWatt.App.ViewModels">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,16">

        <!-- 标题 + 副标题 + 右上操作（与统计 / 历史管理页同款） -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="设备电量" Style="{StaticResource AppPageTitleStyle}" />
                <TextBlock x:Name="SummaryText" Text="—" Style="{StaticResource AppPageSubtitleStyle}" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="RefreshRing" Width="14" Height="14"
                                  IsActive="False" Visibility="Collapsed" />
                    <FontIcon x:Name="RefreshIcon" FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock x:Name="RefreshText" Text="刷新" />
                </StackPanel>
            </Button>
        </Grid>

        <ListView x:Name="DeviceList" Grid.Row="1" Margin="0,12,0,0" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="v:DeviceRowModel">
                    <Border Style="{StaticResource AppCardStyle}"
                            Padding="16,12"
                            Margin="0,0,0,8"
                            RightTapped="DeviceRow_RightTapped">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <FontIcon Grid.Column="0" FontSize="22" Glyph="{x:Bind IconGlyph}" />
                            <StackPanel Grid.Column="1" Spacing="6">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                            Background="{x:Bind SourceBackgroundBrush}">
                                        <TextBlock Text="{x:Bind SourceText}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{x:Bind SourceBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="⚡" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{x:Bind ProgressBrush}"
                                               Visibility="{x:Bind IsCharging}" />
                                </Grid>
                                <ProgressBar Value="{x:Bind Progress}" Maximum="100" Height="6"
                                             CornerRadius="3" Foreground="{x:Bind ProgressBrush}" />
                                <TextBlock Text="{x:Bind SubText}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind PercentText}" FontSize="26"
                                       FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{x:Bind PercentBrush}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="6" Visibility="Collapsed">
            <FontIcon Glyph="&#xE702;" FontSize="40" HorizontalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="未发现设备" FontSize="15" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="连接蓝牙设备或插入 2.4G 接收器，然后点击刷新" FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <!-- 已屏蔽设备入口：永久移除后设备不在列表里，恢复入口只能放这；没有屏蔽记录时整行隐藏 -->
        <HyperlinkButton x:Name="BlockedBar" Grid.Row="2" Margin="0,4,0,0" Padding="0"
                         HorizontalAlignment="Left" Click="ManageBlocked_Click" Visibility="Collapsed">
            <TextBlock x:Name="BlockedText" FontSize="12" />
        </HyperlinkButton>
    </Grid>
</Page>
