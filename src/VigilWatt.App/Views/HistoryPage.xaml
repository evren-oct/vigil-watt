<Page
    x:Class="VigilWatt.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:VigilWatt.App.ViewModels">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="40,24,40,24" MaxWidth="900">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="7" VerticalAlignment="Center">
                <TextBlock Text="历史管理" Style="{StaticResource AppPageTitleStyle}" />
                <TextBlock x:Name="SubtitleText" Text="—" Style="{StaticResource AppPageSubtitleStyle}" />
            </StackPanel>
            <HyperlinkButton x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click"
                             Padding="0" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;"
                              Foreground="{ThemeResource AppAccentBrush}" />
                    <TextBlock Text="刷新" FontSize="15"
                               Foreground="{ThemeResource AppAccentBrush}" />
                </StackPanel>
            </HyperlinkButton>
        </Grid>

        <!-- 操作结果提示（删除成功 / 失败） -->
        <InfoBar x:Name="ResultBar" Grid.Row="1" Margin="0,16,0,0" IsOpen="False" />

        <!-- 概览：裸数字 -->
        <Grid Grid.Row="2" Margin="0,24,0,0" ColumnSpacing="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="数据库大小" Style="{StaticResource AppKpiLabelStyle}" />
                <TextBlock>
                    <Run x:Name="KpiFileSizeNumber" FontSize="22" FontWeight="Bold"
                         Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Run x:Name="KpiFileSizeUnit" FontSize="13"
                         Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </TextBlock>
                <TextBlock Text="history.db" Style="{StaticResource AppKpiSubStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="采样总条数" Style="{StaticResource AppKpiLabelStyle}" />
                <TextBlock x:Name="KpiTotal" Text="—" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="全部设备合计" Style="{StaticResource AppKpiSubStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="设备数" Style="{StaticResource AppKpiLabelStyle}" />
                <TextBlock x:Name="KpiDevices" Text="—" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="含已离线的历史设备" Style="{StaticResource AppKpiSubStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="3" Spacing="4">
                <TextBlock Text="最早记录" Style="{StaticResource AppKpiLabelStyle}" />
                <TextBlock x:Name="KpiEarliest" Text="—" FontSize="22" FontWeight="Bold" />
                <TextBlock x:Name="KpiEarliestSub" Text="—" Style="{StaticResource AppKpiSubStyle}" />
            </StackPanel>
        </Grid>

        <!-- 按设备清理：列表自己滚（虚拟化），设备再多也不把页面撑长 -->
        <Grid Grid.Row="3" Margin="0,24,0,0" RowDefinitions="Auto,Auto,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <TextBlock Text="按设备清理" Style="{StaticResource AppSectionTitleStyle}" />
                <TextBlock Grid.Column="1" Text="勾选后可批量删除，删除不可恢复" FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>

            <Grid Grid.Row="1" Height="36" Margin="0,10,0,0">
                <Grid.Resources>
                    <StaticResource x:Key="TextControlBackground" ResourceKey="AppSearchFillBrush" />
                    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="AppSearchFillBrush" />
                    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="AppSearchFillBrush" />
                    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="SystemControlTransparentBrush" />
                    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="SystemControlTransparentBrush" />
                    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SystemControlTransparentBrush" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    <x:Double x:Key="TextControlBackgroundRestOpacity">1</x:Double>
                    <x:Double x:Key="TextControlBackgroundHoverOpacity">1</x:Double>
                    <x:Double x:Key="TextControlBackgroundFocusedOpacity">1</x:Double>
                </Grid.Resources>
                <Border Background="{ThemeResource AppSearchFillBrush}" CornerRadius="10" />
                <FontIcon Glyph="&#xE721;" FontSize="14" Margin="12,0,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBox x:Name="DeviceSearchBox" PlaceholderText="搜索设备"
                         Background="Transparent" BorderThickness="0" CornerRadius="10"
                         Padding="34,8,10,8" Height="36" VerticalContentAlignment="Center"
                         TextChanged="DeviceSearch_TextChanged" />
            </Grid>

            <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource AppCardStyle}">
                <Grid>
                    <ListView x:Name="DeviceList" SelectionMode="None" Padding="0,4,0,4">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="v:HistoryDeviceRow">
                                <Border Background="Transparent"
                                        PointerEntered="Row_PointerEntered"
                                        PointerExited="Row_PointerExited">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="16"
                                          Padding="20,16">
                                        <!-- CheckBox 默认 MinWidth=120，不归零会在名字前留一大段空白 -->
                                        <CheckBox Grid.Column="0" MinWidth="0" CornerRadius="6"
                                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  Checked="Row_CheckChanged" Unchecked="Row_CheckChanged" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="15"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind CountText}" FontSize="13" Width="88"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind RangeText}" FontSize="13" Width="190"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <Button Grid.Column="4" Content="删除" FontSize="13" Tag="{x:Bind DeviceId}"
                                                Click="DeleteRow_Click" Padding="4,2"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Button.Resources>
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E2445C" />
                                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E2445C" />
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="6" Padding="0,36" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE9D2;" FontSize="34" HorizontalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="暂无历史数据" FontSize="15" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="采集到电量读数后会出现在这里" FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="NoMatchState" Text="没有匹配的设备" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <TextBlock x:Name="SelectionText" VerticalAlignment="Center" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="DeleteSelectedButton" Grid.Column="1" IsEnabled="False"
                        Click="DeleteSelected_Click" Content="删除选中设备的历史"
                        FontSize="15" Padding="0" Background="Transparent" BorderThickness="0"
                        Foreground="{ThemeResource AppDangerBrush}">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E2445C" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E2445C" />
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
