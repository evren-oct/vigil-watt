<Page
    x:Class="VigilWatt.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- 分组头只要一行标题：去掉 Expander 默认的卡片底、边框和 16px 内边距 -->
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
        <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
        <Thickness x:Key="ExpanderHeaderPadding">0</Thickness>
        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
        <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
        <Thickness x:Key="ExpanderContentUpBorderThickness">0</Thickness>
        <Thickness x:Key="ExpanderContentPadding">0</Thickness>
        <!-- 代码动态生成的插件行也复用这两条，保证两种来源的行长得一样 -->
        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsGroupStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 标题与搜索固定不随内容滚走：搜索框是页面第一个可聚焦元素，留在 ScrollViewer 里时，
             焦点一旦落到它（窗口激活、点击空白处），ScrollViewer 会 ScrollIntoView 把页面拽回顶部 -->
        <StackPanel Grid.Row="0" Margin="40,24,40,0" Spacing="12" MaxWidth="900">
            <StackPanel Spacing="7">
                <TextBlock Text="{Binding Settings_Title, Mode=OneWay}"
                           Style="{StaticResource AppPageTitleStyle}" />
                <TextBlock Text="{Binding Settings_Subtitle, Mode=OneWay}"
                           Style="{StaticResource AppPageSubtitleStyle}" />
            </StackPanel>

            <Grid Height="40">
                <Grid.Resources>
                    <StaticResource x:Key="TextControlBackground" ResourceKey="AppSearchFillBrush" />
                    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="AppSearchFillBrush" />
                    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="AppSearchFillBrush" />
                    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="SystemControlTransparentBrush" />
                    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="SystemControlTransparentBrush" />
                    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SystemControlTransparentBrush" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    <x:Double x:Key="TextControlBackgroundRestOpacity">1</x:Double>
                    <x:Double x:Key="TextControlBackgroundHoverOpacity">1</x:Double>
                    <x:Double x:Key="TextControlBackgroundFocusedOpacity">1</x:Double>
                </Grid.Resources>
                <Border Background="{ThemeResource AppSearchFillBrush}" CornerRadius="12" />
                <FontIcon Glyph="&#xE721;" FontSize="15" Margin="14,0,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBox x:Name="SettingsSearchBox" PlaceholderText="{Binding S_353ed5859d, Mode=OneWay}"
                         Background="Transparent" BorderThickness="0" CornerRadius="12"
                         Padding="38,10,12,10" Height="40" VerticalContentAlignment="Center"
                         TextChanged="SettingsSearch_TextChanged" />
            </Grid>

            <Border x:Name="SearchResultsBorder" Visibility="Collapsed" MaxHeight="240"
                    CornerRadius="12" BorderThickness="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ScrollViewer MaxHeight="240">
                    <StackPanel x:Name="SearchResultsPanel" />
                </ScrollViewer>
            </Border>
            <TextBlock x:Name="SearchEmptyText" Text="{Binding S_fafc98f909, Mode=OneWay}" Visibility="Collapsed"
                       Style="{StaticResource RowDescStyle}" />
        </StackPanel>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Padding="40,16,40,24"
                      HorizontalContentAlignment="Stretch">
            <StackPanel x:Name="SettingsContent" Spacing="24" MaxWidth="900">

                <!-- 外观 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding S_09b58aa342, Mode=OneWay}" Style="{StaticResource AppSectionTitleStyle}" />
                    <Border Style="{StaticResource AppCardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="20,18" MinHeight="64"
                              Background="Transparent"
                              PointerEntered="SettingsRow_PointerEntered"
                              PointerExited="SettingsRow_PointerExited">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Language_Title, Mode=OneWay}"
                                           Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="{Binding Language_Description, Mode=OneWay}"
                                           Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="LanguageCombo" Width="180"
                                      VerticalAlignment="Center"
                                      SelectionChanged="Language_Changed">
                                <ComboBoxItem Content="{Binding Language_Auto, Mode=OneWay}" Tag="auto" />
                                <ComboBoxItem Content="{Binding Language_Zh, Mode=OneWay}" Tag="zh-CN" />
                                <ComboBoxItem Content="{Binding Language_Ru, Mode=OneWay}" Tag="ru-RU" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource AppCardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="20,18" MinHeight="64"
                              Background="Transparent"
                              PointerEntered="SettingsRow_PointerEntered"
                              PointerExited="SettingsRow_PointerExited">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding S_9a70fbd2cc, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock x:Name="BackdropHintText" Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="BackdropCombo" Width="180"
                                      VerticalAlignment="Center"
                                      SelectionChanged="Backdrop_Changed">
                                <ComboBoxItem Content="{Binding S_4afad87755, Mode=OneWay}" Tag="Auto" />
                                <ComboBoxItem Content="{Binding S_bc6d39ba88, Mode=OneWay}" Tag="Mica" />
                                <ComboBoxItem Content="{Binding S_9419ed48c5, Mode=OneWay}" Tag="Acrylic" />
                                <ComboBoxItem Content="{Binding S_c502e4a090, Mode=OneWay}" Tag="Solid" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 提醒：多行分组，可折叠 -->
                <Expander x:Name="ReminderGroup" Style="{StaticResource SettingsGroupStyle}" IsExpanded="True"
                          Expanding="Group_Expanding" Collapsed="Group_Collapsed">
                    <Expander.Header>
                        <Grid Height="34" Padding="4,0,6,0" ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding S_81944e48a3, Mode=OneWay}" Style="{StaticResource AppSectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ReminderSummary" Grid.Column="1" FontSize="11" Opacity="0"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Expander.Header>
                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_242462245f, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{Binding S_4dfddc9137, Mode=OneWay}"
                                               Style="{StaticResource RowDescStyle}" MaxWidth="460" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="ThresholdBox" Value="20"
                                           Minimum="0" Maximum="80" SpinButtonPlacementMode="Inline"
                                           Width="160" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_f72a2d2e3f, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{Binding S_c75de5fb7a, Mode=OneWay}"
                                               Style="{StaticResource RowDescStyle}" MaxWidth="460" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="RemainingTimeEstimateToggle"
                                              OnContent="{Binding S_b4217093bc, Mode=OneWay}" OffContent="{Binding S_a3332f1c94, Mode=OneWay}"
                                              MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_8a31bbf193, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{Binding S_bbaf600d99, Mode=OneWay}"
                                               Style="{StaticResource RowDescStyle}" MaxWidth="460" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="StartMinimizedToggle"
                                              OnContent="{Binding S_b4217093bc, Mode=OneWay}" OffContent="{Binding S_a3332f1c94, Mode=OneWay}"
                                              MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_8cbccd927d, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{Binding S_ade3f755e0, Mode=OneWay}"
                                               Style="{StaticResource RowDescStyle}" MaxWidth="460" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="AutostartToggle"
                                              OnContent="{Binding S_b4217093bc, Mode=OneWay}" OffContent="{Binding S_a3332f1c94, Mode=OneWay}"
                                              MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- 数据采集 -->
                <Expander x:Name="DataGroup" Style="{StaticResource SettingsGroupStyle}" IsExpanded="True"
                          Expanding="Group_Expanding" Collapsed="Group_Collapsed">
                    <Expander.Header>
                        <Grid Height="34" Padding="4,0,6,0" ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding S_a68d470c54, Mode=OneWay}" Style="{StaticResource AppSectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="DataSummary" Grid.Column="1" FontSize="11" Opacity="0"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Expander.Header>
                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_01f122f48b, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{Binding S_2bb5bcf0ab, Mode=OneWay}"
                                               Style="{StaticResource RowDescStyle}" MaxWidth="460" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="SampleBox" Value="5"
                                           Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline"
                                           Width="160" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_d358c45c3c, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{Binding S_77833f9923, Mode=OneWay}"
                                               Style="{StaticResource RowDescStyle}" MaxWidth="460" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="RetentionBox" Value="90"
                                           Minimum="7" Maximum="365" SpinButtonPlacementMode="Inline"
                                           Width="160" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_b9419e0773, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{Binding S_5e2dfc2014, Mode=OneWay}"
                                               Style="{StaticResource RowDescStyle}" MaxWidth="460" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="SystemBatteryToggle"
                                              OnContent="{Binding S_b4217093bc, Mode=OneWay}" OffContent="{Binding S_a3332f1c94, Mode=OneWay}"
                                              MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- 2.4G 设备插件（品牌级：只列品牌，具体型号由扫描识别） -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding S_8b66d101bf, Mode=OneWay}" Style="{StaticResource AppSectionTitleStyle}" />
                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel>
                            <!-- 二十多个品牌平铺会把这一区撑到 1500px 以上，选择动作移进弹窗，这里只留摘要 -->
                            <Grid x:Name="PluginRowRoot" ColumnDefinitions="*,Auto" ColumnSpacing="12"
                                  Padding="20,18" MinHeight="64" Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_dd776c8243, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock x:Name="PluginSummaryText" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <HyperlinkButton Grid.Column="1" x:Name="PluginManageButton" Content="{Binding S_4989b5cf94, Mode=OneWay}"
                                                 Padding="0" FontSize="15"
                                                 VerticalAlignment="Center" Click="PluginManage_Click" />
                            </Grid>
                            <TextBlock Margin="20,0,20,18" Style="{StaticResource RowDescStyle}"
                                       Text="{Binding S_2cc2e9d236, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 小组件 -->
                <Expander x:Name="WidgetGroup" Style="{StaticResource SettingsGroupStyle}" IsExpanded="True"
                          Expanding="Group_Expanding" Collapsed="Group_Collapsed">
                    <Expander.Header>
                        <Grid Height="34" Padding="4,0,6,0" ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding S_f74efb4fda, Mode=OneWay}" Style="{StaticResource AppSectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="WidgetSummary" Grid.Column="1" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Expander.Header>
                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_f5f4160a69, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{Binding S_72b1f9f267, Mode=OneWay}"
                                               Style="{StaticResource RowDescStyle}" MaxWidth="460" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="WidgetToggle"
                                              OnContent="{Binding S_b4217093bc, Mode=OneWay}" OffContent="{Binding S_a3332f1c94, Mode=OneWay}"
                                              MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_75589922ea, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock x:Name="WidgetModeHintText" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="WidgetModeCombo" Width="180"
                                          VerticalAlignment="Center"
                                          SelectionChanged="WidgetMode_Changed">
                                    <ComboBoxItem Content="{Binding S_e828716785, Mode=OneWay}" Tag="Topmost" />
                                    <ComboBoxItem Content="{Binding S_cb618ebdb2, Mode=OneWay}" Tag="Normal" />
                                    <ComboBoxItem Content="{Binding S_ab61cce9ed, Mode=OneWay}" Tag="Desktop" />
                                </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_69729065e4, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{Binding S_ee42d1ee9f, Mode=OneWay}"
                                               Style="{StaticResource RowDescStyle}" MaxWidth="460" />
                                </StackPanel>
                                <!-- 档位由代码按 WidgetMaxDevicesOptions.Choices 生成，范围只有一处定义 -->
                                <ComboBox Grid.Column="1" x:Name="WidgetMaxCombo" Width="180"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- 任务栏 -->
                <Expander x:Name="TaskbarGroup" Style="{StaticResource SettingsGroupStyle}" IsExpanded="True"
                          Expanding="Group_Expanding" Collapsed="Group_Collapsed">
                    <Expander.Header>
                        <Grid Height="34" Padding="4,0,6,0" ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding S_3405fcce4a, Mode=OneWay}" Style="{StaticResource AppSectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TaskbarSummary" Grid.Column="1" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Expander.Header>
                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_33c08b2a0c, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{Binding S_af0b59e37a, Mode=OneWay}"
                                               Style="{StaticResource RowDescStyle}" MaxWidth="460" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="TaskbarToggle"
                                              OnContent="{Binding S_b4217093bc, Mode=OneWay}" OffContent="{Binding S_a3332f1c94, Mode=OneWay}"
                                              MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_102d692a3b, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock x:Name="TaskbarModeHintText" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="TaskbarModeCombo" Width="180"
                                          VerticalAlignment="Center"
                                          SelectionChanged="TaskbarMode_Changed">
                                    <ComboBoxItem Content="{Binding S_94a78d5371, Mode=OneWay}" Tag="All" />
                                    <ComboBoxItem Content="{Binding S_a2d96674aa, Mode=OneWay}" Tag="Lowest" />
                                </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_69729065e4, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{Binding S_0149536f24, Mode=OneWay}"
                                               Style="{StaticResource RowDescStyle}" MaxWidth="460" />
                                </StackPanel>
                                <!-- 档位由代码按 TaskbarBatteryOptions.Choices 生成，范围只有一处定义 -->
                                <ComboBox Grid.Column="1" x:Name="TaskbarMaxCombo" Width="180"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <Grid x:Name="TaskbarDeviceRowRoot" ColumnDefinitions="*,Auto" ColumnSpacing="12"
                                  Padding="20,18" MinHeight="64" Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_2c3913a887, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock x:Name="TaskbarDeviceSummaryText" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <HyperlinkButton Grid.Column="1" x:Name="TaskbarDeviceMoreButton" Content="{Binding S_9b0c6c7858, Mode=OneWay}"
                                                 Padding="0" FontSize="15"
                                                 VerticalAlignment="Center" Click="TaskbarDeviceMore_Click" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_651b087145, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{Binding S_35218e55cd, Mode=OneWay}"
                                               Style="{StaticResource RowDescStyle}" MaxWidth="460" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <ComboBox x:Name="TaskbarScreenCombo" Width="280" VerticalAlignment="Center" />
                                    <!-- 插拔显示器后设置页不会自动重扫（页面被缓存复用），给一个手动重扫入口 -->
                                    <Button x:Name="TaskbarScreenRefreshBtn" Click="TaskbarScreenRefresh_Click"
                                            Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="{Binding S_27cf2a8e22, Mode=OneWay}"
                                            AutomationProperties.Name="{Binding S_27cf2a8e22, Mode=OneWay}">
                                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_3f17e10afc, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{Binding S_086aabc6db, Mode=OneWay}"
                                               Style="{StaticResource RowDescStyle}" MaxWidth="460" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="TaskbarLockToggle"
                                              OnContent="{Binding S_b4217093bc, Mode=OneWay}" OffContent="{Binding S_a3332f1c94, Mode=OneWay}"
                                              MinWidth="0" VerticalAlignment="Center"
                                              Toggled="TaskbarLock_Toggled" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_401f5099a6, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{Binding S_9c09cc5fb1, Mode=OneWay}"
                                               Style="{StaticResource RowDescStyle}" MaxWidth="460" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="TaskbarResetBtn"
                                        Content="{Binding S_3d81345303, Mode=OneWay}" Width="80"
                                        VerticalAlignment="Center"
                                        Click="TaskbarReset_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- 日志：低频设置，默认收起 -->
                <Expander x:Name="LogExpander" Style="{StaticResource SettingsGroupStyle}" IsExpanded="False"
                          Expanding="Group_Expanding" Collapsed="Group_Collapsed">
                    <Expander.Header>
                        <Grid Height="34" Padding="4,0,6,0" ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding S_4de50894b8, Mode=OneWay}" Style="{StaticResource AppSectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="LogSummary" Grid.Column="1" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Expander.Header>
                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_307ac59fee, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock x:Name="LogLevelHintText" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <!-- 档位由代码按 LogLevelOptions.Choices 生成，取值只有一处定义 -->
                                <ComboBox Grid.Column="1" x:Name="LogLevelCombo" Width="180"
                                          VerticalAlignment="Center"
                                          SelectionChanged="LogLevel_Changed" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_f5c57acd1a, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{Binding S_fe3c1bbb3e, Mode=OneWay}"
                                               Style="{StaticResource RowDescStyle}" MaxWidth="460" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="LogRetentionBox" Value="14"
                                           Minimum="1" Maximum="365" SpinButtonPlacementMode="Inline"
                                           Width="160" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Padding="20,18" MinHeight="64"
                                  Background="Transparent"
                                  PointerEntered="SettingsRow_PointerEntered"
                                  PointerExited="SettingsRow_PointerExited">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding S_01516b6cd4, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{Binding S_05ae85825a, Mode=OneWay}"
                                               Style="{StaticResource RowDescStyle}" MaxWidth="460" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button x:Name="OpenLogDirButton" Click="OpenLogDir_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                            <TextBlock Text="{Binding S_031c105578, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ClearLogsButton" Click="ClearLogs_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            <TextBlock Text="{Binding S_1ef9339dba, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- 固定底部保存条：设置项再多也不用滚到页末才能保存 -->
        <Border Grid.Row="2" Margin="40,0,40,20" Padding="20,12" CornerRadius="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon x:Name="SavedIcon" Glyph="&#xE73E;" FontSize="14" Visibility="Collapsed"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="SavedText" VerticalAlignment="Center" FontSize="13"
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="SaveButton" Style="{ThemeResource AccentButtonStyle}"
                        Click="Save_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="{Binding S_bb79ec7c15, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
