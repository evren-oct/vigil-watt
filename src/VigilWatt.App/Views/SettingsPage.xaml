<Page
    x:Class="VigilWatt.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- 设置行统一语言：左标题+说明、右控件；样式放 Page.Resources，代码动态生成的插件行也复用同一套，保证两种来源的行长得一样 -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <!-- 行内自带 0,12 上下留白，卡片只留 4px 边距，视觉上每行 16px -->
            <Setter Property="Padding" Value="16,4" />
        </Style>
    </Page.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="0" Padding="20,16"
                      ViewChanged="SettingsScrollViewer_ViewChanged"
                      SizeChanged="SettingsScrollViewer_SizeChanged">
            <StackPanel x:Name="SettingsContent" Spacing="18" MaxWidth="720" HorizontalAlignment="Left">

                <StackPanel Spacing="2">
                    <TextBlock Text="设置" Style="{StaticResource AppPageTitleStyle}" />
                    <TextBlock Text="外观、提醒、数据采集、2.4G 插件与桌面小组件"
                               Style="{StaticResource AppPageSubtitleStyle}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBox x:Name="SettingsSearchBox" PlaceholderText="搜索设置或设备插件"
                             TextChanged="SettingsSearch_TextChanged" />
                    <Border x:Name="SearchResultsBorder" Visibility="Collapsed" MaxHeight="240"
                            CornerRadius="6" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <ScrollViewer MaxHeight="240">
                            <StackPanel x:Name="SearchResultsPanel" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock x:Name="SearchEmptyText" Text="没有匹配的设置项" Visibility="Collapsed"
                               Style="{StaticResource RowDescStyle}" />
                </StackPanel>

                <!-- 外观 -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,0">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="窗口背景" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock x:Name="BackdropHintText" Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="BackdropCombo" Width="180"
                                      VerticalAlignment="Center"
                                      SelectionChanged="Backdrop_Changed">
                                <ComboBoxItem Content="自动" Tag="Auto" />
                                <ComboBoxItem Content="云母 Mica" Tag="Mica" />
                                <ComboBoxItem Content="磨砂 Acrylic" Tag="Acrylic" />
                                <ComboBoxItem Content="纯色" Tag="Solid" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 提醒 -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,0">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="提醒" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="低电量提醒阈值" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="低于该电量时弹托盘提醒，0 表示关闭" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="ThresholdBox" Value="20"
                                           Minimum="0" Maximum="80" SpinButtonPlacementMode="Inline"
                                           Width="160" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="剩余时间估算" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="根据近期放电速度估算，并显示在设备列表和任务栏悬停提示" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="RemainingTimeEstimateToggle"
                                              OnContent="开" OffContent="关"
                                              MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="启动时最小化到托盘" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="开机后直接驻留托盘，不弹出主窗口" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="StartMinimizedToggle"
                                              OnContent="开" OffContent="关"
                                              MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="开机自动启动" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="写入当前用户的开机启动项（HKCU Run）" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="AutostartToggle"
                                              OnContent="开" OffContent="关"
                                              MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 数据采集 -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,0">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="数据采集" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="采样间隔" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="电量无变化时也按此间隔写一条历史（分钟）" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="SampleBox" Value="5"
                                           Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline"
                                           Width="160" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="历史保留天数" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="超过天数的历史记录会被自动清理（天）" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="RetentionBox" Value="90"
                                           Minimum="7" Maximum="365" SpinButtonPlacementMode="Inline"
                                           Width="160" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 本机 -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,0">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="本机" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="监控本机电量" Style="{StaticResource RowTitleStyle}" />
                                <TextBlock Text="把笔记本电池也显示在设备列表、小组件与历史统计里。台式机无电池时不显示"
                                           Style="{StaticResource RowDescStyle}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="SystemBatteryToggle"
                                          OnContent="开" OffContent="关"
                                          MinWidth="0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 2.4G 设备插件（品牌级：只列品牌，具体型号由扫描识别） -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,0">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="2.4G 设备插件" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <!-- 开关由代码按已发现插件动态生成（DeviceManager.Plugins），新增品牌自动出现在这里 -->
                            <StackPanel x:Name="PluginPanel" />
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <TextBlock Margin="0,12,0,6" Style="{StaticResource RowDescStyle}"
                                       Text="2.4G 协议按品牌适配，一个品牌一行开关；具体型号由扫描自动识别，不需要在这里选。开启某个品牌即授权它发送工作所需的帧（没有独立的「写入许可」开关），会写帧的品牌默认关闭。识别不到设备时，可查看日志 %LOCALAPPDATA%\VigilWatt\logs（按日 app-日期.log）" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 小组件 -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,0">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="小组件" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="桌面小组件" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="桌面悬浮电量条，可拖动、不进 Alt-Tab 与任务栏" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="WidgetToggle"
                                              OnContent="开" OffContent="关"
                                              MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="显示方式" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock x:Name="WidgetModeHintText" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="WidgetModeCombo" Width="180"
                                          VerticalAlignment="Center"
                                          SelectionChanged="WidgetMode_Changed">
                                    <ComboBoxItem Content="浮在其它窗口上方" Tag="Topmost" />
                                    <ComboBoxItem Content="普通窗口" Tag="Normal" />
                                    <ComboBoxItem Content="固定在桌面" Tag="Desktop" />
                                </ComboBox>
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="最多显示设备数" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="一屏只显示这么多条，其余用鼠标滚轮查看"
                                               Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <!-- 档位由代码按 WidgetMaxDevicesOptions.Choices 生成，范围只有一处定义 -->
                                <ComboBox Grid.Column="1" x:Name="WidgetMaxCombo" Width="180"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 任务栏 -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,0">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="任务栏" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="任务栏电量贴片" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="在任务栏里（系统托盘左边）钉一条电量胶囊，未锁定时按住可沿任务栏拖动；本机电量不参与（系统已有电池图标）"
                                               Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="TaskbarToggle"
                                              OnContent="开" OffContent="关"
                                              MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="锁定贴片位置" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="防止按住贴片时误拖；关闭后可沿任务栏调整位置，保存后生效"
                                               Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="TaskbarLockToggle"
                                              OnContent="开" OffContent="关"
                                              MinWidth="0" VerticalAlignment="Center"
                                              AutomationProperties.Name="锁定贴片位置" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="显示内容" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock x:Name="TaskbarModeHintText" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="TaskbarModeCombo" Width="180"
                                          VerticalAlignment="Center"
                                          SelectionChanged="TaskbarMode_Changed">
                                    <ComboBoxItem Content="全部在线设备" Tag="All" />
                                    <ComboBoxItem Content="仅最低电量一台" Tag="Lowest" />
                                </ComboBox>
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="最多显示设备数" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="超出部分折叠成 +N（选「仅最低电量一台」时此项不生效）"
                                               Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <!-- 档位由代码按 TaskbarBatteryOptions.Choices 生成，范围只有一处定义 -->
                                <ComboBox Grid.Column="1" x:Name="TaskbarMaxCombo" Width="180"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="显示屏幕" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="贴片钉在哪块显示器的任务栏上；那块屏不在时临时贴主屏" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <ComboBox x:Name="TaskbarScreenCombo" Width="280" VerticalAlignment="Center" />
                                    <!-- 插拔显示器后设置页不会自动重扫（页面被缓存复用），给一个手动重扫入口 -->
                                    <Button x:Name="TaskbarScreenRefreshBtn" Click="TaskbarScreenRefresh_Click"
                                            Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="重新扫描显示器"
                                            AutomationProperties.Name="重新扫描显示器">
                                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="重置贴片位置" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="将贴片恢复为默认位置（紧贴系统托盘左侧）"
                                               Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="TaskbarResetBtn"
                                        Content="重置" Width="80"
                                        VerticalAlignment="Center"
                                        Click="TaskbarReset_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 日志 -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,0">
                        <Border Width="3" Height="14" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="日志" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="日志级别" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock x:Name="LogLevelHintText" Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <!-- 档位由代码按 LogLevelOptions.Choices 生成，取值只有一处定义 -->
                                <ComboBox Grid.Column="1" x:Name="LogLevelCombo" Width="180"
                                          VerticalAlignment="Center"
                                          SelectionChanged="LogLevel_Changed" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="日志保留天数" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="日志按日生成，超过天数的旧日志自动清理（天）。改后需重启应用生效"
                                               Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" x:Name="LogRetentionBox" Value="14"
                                           Minimum="1" Maximum="365" SpinButtonPlacementMode="Inline"
                                           Width="160" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource RowDividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Padding="0,12">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="日志文件" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="%LOCALAPPDATA%\VigilWatt\logs（按日：app-日期.log）"
                                               Style="{StaticResource RowDescStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button x:Name="OpenLogDirButton" Click="OpenLogDir_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                            <TextBlock Text="打开目录" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ClearLogsButton" Click="ClearLogs_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            <TextBlock Text="清空日志" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Button x:Name="BackToSearchButton" Grid.Row="0" Width="44" Height="44"
                Padding="0" CornerRadius="22" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="20,20,20,16" Visibility="Collapsed" Click="BackToSearch_Click"
                AutomationProperties.Name="回到搜索区"
                ToolTipService.ToolTip="回到搜索区">
            <FontIcon Glyph="&#xE70E;" FontSize="18" />
        </Button>

        <!-- 底栏固定不随内容滚走：左侧即时反馈，右侧保存操作 -->
        <Border Grid.Row="1" Padding="20,12"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon x:Name="SavedIcon" Glyph="&#xE73E;" FontSize="14" Visibility="Collapsed"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="SavedText" VerticalAlignment="Center" FontSize="13"
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="SaveButton" Style="{ThemeResource AccentButtonStyle}"
                        Click="Save_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="保存设置" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
