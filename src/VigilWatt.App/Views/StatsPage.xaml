<Page
    x:Class="VigilWatt.App.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="40,24,40,88" MaxWidth="900">

        <!-- 标题栏：标题 + 当前上下文副标题 + 刷新 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="7" VerticalAlignment="Center">
                <TextBlock Text="历史统计" Style="{StaticResource AppPageTitleStyle}" />
                <TextBlock x:Name="SubtitleText" Text="—" Style="{StaticResource AppPageSubtitleStyle}" />
            </StackPanel>
            <HyperlinkButton x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click"
                             Padding="0" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="RefreshRing" Width="14" Height="14"
                                  IsActive="False" Visibility="Collapsed" />
                    <FontIcon x:Name="RefreshIcon" FontSize="14" Glyph="&#xE72C;"
                              Foreground="{ThemeResource AppAccentBrush}" />
                    <TextBlock x:Name="RefreshText" Text="刷新" FontSize="15"
                               Foreground="{ThemeResource AppAccentBrush}" />
                </StackPanel>
            </HyperlinkButton>
        </Grid>

        <!-- 筛选行：设备下拉 + 时间范围分段控件，不套卡 -->
        <Grid Grid.Row="1" Margin="0,24,0,0" ColumnDefinitions="Auto,*,Auto">
            <ComboBox x:Name="DeviceCombo" MinWidth="260" HorizontalAlignment="Left"
                      DisplayMemberPath="Name" PlaceholderText="选择设备"
                      SelectionChanged="Device_SelectionChanged" />
            <Border Grid.Column="2" Background="{ThemeResource AppSelectorTrackBrush}"
                    CornerRadius="12" Padding="3">
                <Border.Resources>
                    <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SystemControlTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="AppHoverFillBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="AppSearchFillBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="AppSelectorPillBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="AppSelectorPillBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="AppSelectorPillBrush" />
                    <StaticResource x:Key="ToggleButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SystemControlTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SystemControlTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SystemControlTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SystemControlTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SystemControlTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SystemControlTransparentBrush" />
                    <Style x:Key="SegmentedButtonStyle" TargetType="ToggleButton">
                        <Setter Property="CornerRadius" Value="9" />
                        <Setter Property="Padding" Value="14,5" />
                        <Setter Property="MinHeight" Value="30" />
                        <Setter Property="FontSize" Value="13" />
                    </Style>
                </Border.Resources>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="Range24" Content="24 小时" Tag="24" IsChecked="True"
                                  Style="{StaticResource SegmentedButtonStyle}" Click="Range_Click" />
                    <ToggleButton x:Name="Range168" Content="7 天" Tag="168"
                                  Style="{StaticResource SegmentedButtonStyle}" Click="Range_Click" />
                    <ToggleButton x:Name="Range720" Content="30 天" Tag="720"
                                  Style="{StaticResource SegmentedButtonStyle}" Click="Range_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 指标摘要：裸数字，32 间距分开 -->
        <Grid Grid.Row="2" Margin="0,24,0,0" ColumnSpacing="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="当前电量" Style="{StaticResource AppKpiLabelStyle}" />
                <TextBlock>
                    <Run x:Name="KpiCurrentNumber" FontSize="22" FontWeight="Bold"
                         Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Run Text="%" FontSize="13"
                         Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </TextBlock>
                <TextBlock x:Name="KpiCurrentSub" Text="—" Style="{StaticResource AppKpiSubStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="区间最高" Style="{StaticResource AppKpiLabelStyle}" />
                <TextBlock>
                    <Run x:Name="KpiMaxNumber" FontSize="22" FontWeight="Bold"
                         Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Run Text="%" FontSize="13"
                         Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </TextBlock>
                <TextBlock x:Name="KpiMaxSub" Text="—" Style="{StaticResource AppKpiSubStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="区间最低" Style="{StaticResource AppKpiLabelStyle}" />
                <TextBlock>
                    <Run x:Name="KpiMinNumber" FontSize="22" FontWeight="Bold"
                         Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Run Text="%" FontSize="13"
                         Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </TextBlock>
                <TextBlock x:Name="KpiMinSub" Text="—" Style="{StaticResource AppKpiSubStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="3" Spacing="4">
                <TextBlock Text="平均电量" Style="{StaticResource AppKpiLabelStyle}" />
                <TextBlock>
                    <Run x:Name="KpiAvgNumber" FontSize="22" FontWeight="Bold"
                         Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Run Text="%" FontSize="13"
                         Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </TextBlock>
                <TextBlock x:Name="KpiAvgSub" Text="—" Style="{StaticResource AppKpiSubStyle}" />
            </StackPanel>
        </Grid>

        <!-- 曲线卡片：内边距给悬停气泡留边，避免贴边裁切 -->
        <Border Grid.Row="3" Margin="0,24,0,0" Style="{StaticResource AppCardStyle}" Padding="22,20,14,14">
            <Grid x:Name="ChartHost" />
        </Border>
    </Grid>
</Page>
