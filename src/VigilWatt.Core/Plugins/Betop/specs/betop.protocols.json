{
  "version": "2026-11-16",
  "vendors": ["0x20BC", "0x20DD"],
  "protocols": {

    // 鲲鹏20/40/50/70 的 0x15 状态报告：2.4G 广播页纯听，有线静默接口发查询。
    // 帧解析仍在 BetopCodec，本段只提供目录判据与协议身份（AGENTS.md §10 的 codeFamily 例外）。
    "betop-status15": {
      "kind": "gamepad",
      "implementation": "code",
      "codeFamily": "BetopPlugin",
      "pollable": true,
      "interface": {
        "anyOf": [
          { "usagePage": 65280 },
          { "usage": 65280 },
          { "usagePage": 255 },
          { "usage": 255 }
        ]
      }
    },

    // T9 只走厂商页 0xFF00 的 Col04 被动状态流；不回答 0x15 查询。
    "betop-t9": {
      "kind": "gamepad",
      "implementation": "code",
      "codeFamily": "BetopPlugin",
      "pollable": false,
      "interface": {
        "anyOf": [
          { "usagePage": 65280 },
          { "usage": 65280 }
        ]
      }
    }
  }
}
