<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>VigilWatt.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- HistoryStore 的删除/统计逻辑要真跑 SQLite（DELETE 不还空间、VACUUM 不丢数据这类行为只有真库能验） -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!--
    直接链接被验证的源文件，测的是真代码，不是复制品。
    这些文件都刻意做成零依赖的纯逻辑，所以能脱离 WinRT 单独编译——
    正因如此这里用 <Compile Include> 而不是 ProjectReference：Core 的目标框架是
    net8.0-windows10.0.19041.0，本测试项目保持纯净的 net8.0（AnyCPU），
    不引入 Windows SDK / WinRT 依赖。改这些源文件后必须重跑测试。

    HistoryStore 能进这个项目，是因为它虽然碰 SQLite，但不碰 WinRT：
    依赖只有 Microsoft.Data.Sqlite + AppPaths + Log + DeviceStatus（全是纯 .NET）。
    它靠 HistoryStore(dbPath) 的可选构造参数指向临时库，测试因此不碰真实 history.db。
  -->
