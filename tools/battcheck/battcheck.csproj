<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BattCheck</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- 直接引用二改主线 Core：验证的是**应用真正会跑的那份**扫描/句柄/判据，不是复制品 -->
    <ProjectReference Include="..\..\src\VigilWatt.Core\VigilWatt.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- VgnY2Codec 在 Core 里是 internal（只有插件用），这里链接同一份源文件，逻辑仍是那一份 -->
    <Compile Include="..\..\src\VigilWatt.Core\Plugins\Vgn\VgnY2Codec.cs" Link="VgnY2Codec.cs" />
  </ItemGroup>

</Project>
